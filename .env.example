# The Raven's Eye — Environment Variables Configuration

# OpenAI API Key (Obtain from https://platform.openai.com/api-keys)
OPENAI_API_KEY=your_openai_api_key_here

# OpenAI Model configuration (Optional, default is gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# Google Gemini API Key (Optional fallback if using Gemini)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model configuration (Optional, default is gemini-3.5-flash-lite)
GEMINI_MODEL=gemini-3.5-flash-lite
